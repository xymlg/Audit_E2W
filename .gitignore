# ============================================================================
# 版本控制忽略清单
# 本仓库只纳入工具源码、测试、构建配置和说明文档
# 客户资料、缓存、虚拟环境与构建产物不纳入版本控制
# ============================================================================

# ---------- 虚拟环境 ----------
.venv/
venv/
env/

# ---------- Python 缓存与构建产物 ----------
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---------- 工具自动备份（带时间戳的副本，每次写盘都会新增）----------
_backup/

# ---------- 报告与工作簿（客户资料，不入版本控制）----------
*.docx
*.docx~
*.xlsx
*.xlsm
资料归档/
# 明确：工具源码（*.py / *.pyw）与文档不受影响

# ---------- Office 临时/锁文件（Word、Excel 打开文件时生成）----------
~$*
*.tmp
*.lck

# ---------- 编辑器与系统杂项 ----------
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store
*~

# ---------- 本地临时/试验脚本（不入库，本地保留）----------
_scratch_*
_gen_*

# ---------- 项目内临时/状态目录（约定：本项目文件只落项目内，不写系统临时目录或用户配置目录）----------
.tmp/
.wesync_ui.json
format_profiles/

# 打包工具（本机安装，不入库）
.tools/
